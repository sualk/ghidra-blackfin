# pointer reg
    Preg0 = (0,2)
    Preg0_2 = (0,2)
    Preg3 = (3,5)
    Preg6 = (6,8)

    opc0608 = (6,8)
        
    t11 = (11,11)
    pcrel13m2 = (0,11) signed
    
# move registers
    destgrp = (9,11)
    srcgrp = (6,8)
    destreg_0 = (3,5)
    destreg_1 = (3,5)
    destreg_2 = (3,5)
    destreg_3 = (3,5)
    destreg_4 = (3,5)
    destreg_5 = (3,5)
    destreg_6 = (3,5)
    destreg_7 = (3,5)
    srcreg_0 = (0,2)
    srcreg_1 = (0,2)
    srcreg_2 = (0,2)
    srcreg_3 = (0,2)
    srcreg_4 = (0,2)
    srcreg_5 = (0,2)
    srcreg_6 = (0,2)
    srcreg_7 = (0,2)

    d07 = (7,7)
    s06 = (6,6)

# push/pop
    d08 = (8,8)
    p07 = (7,7)
    w06 = (6,6)

    AllReg = (0,5)

    s09 = (9,9)
    imm7 = (3,9) signed
    
    opc0407 = (4,7)
    x03 = (3,3)
    uimm4 = (0,3)

    opc10 = (10,10)
    g11 = (11,11)

    b10 = (10,10)
    pcrel11 = (0,9) signed

    cbit0004 = (0,4)
    op0506 = (5,6)

    uimm7 = (4,8)

    a05 = (5,5)

    pcrel25hi = (0,7) signed

    AllReg5 = (0,4)
    AllReg5_lo = (0,4)
    AllReg5_hi = (0,4)

    opc0203 = (2,3)
    b07 = (7,7)
    op0406 = (4,6)
    
    Mreg2 = (2,3)
    Mreg5 = (5,6)
    
    Ireg0 = (0,1)
    Ireg3 = (3,4)

    sopc0003 = (0,3)
    aopc0004 = (0,4)

    hl05 = (5,5)
    
# loop setup
    c04 = (4,4)
    soffs = (0,3)
    rop0506 = (5,6)

# dsp fields
    mmod0508 = (5,8)
    mm04 = (4,4)
    p03 = (3,3)
    w102 = (2,2)
    op10001 = (0,1)
;


